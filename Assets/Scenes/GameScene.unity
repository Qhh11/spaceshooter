  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bddbc6658db80bf49a0a9a51d4b33a91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - actorId: 0
    message: Hey there, fellow space cat! This is astronaut Whiskers, reporting for
      comet bouncing duty!
  - actorId: 1
    message: This is astronaut Fluffy, ready to save our planet with my trusty space
      ship and some fancy rope work.
  - actorId: 0
    message: Chief Excellence, do you read me? We're all set to start bouncing these
      comets back into the great unknown.
  - actorId: 2
    message: Good luck, astronauts. The fate of our planet rests in your paws. Don't
      let us down
  - actorId: 1
    message: Ha! As if we would. Let's do this, Whiskers
  - actorId: 0
    message: You got it, Fluffy. Comet bouncing, engage!
  actors:
  - name: Whiskers
    sprite: {fileID: 21300000, guid: cd59ecd11a40e8d46954f8dfe3d821a1, type: 3}
  - name: Fluffy
    sprite: {fileID: 21300000, guid: 2a8b75e7f31a23e43954ca02641a3c7a, type: 3}
  - name: Chief Excellence (transmission ...)
    sprite: {fileID: 21300000, guid: 764efdb765467d149b16da9e49aaaf15, type: 3}
